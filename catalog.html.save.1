<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">


    <link rel="icon" type="image/jpeg" href="/styling/amazonFavicon.jpg">
    <title>Amazon.com. Spend less. Smile more.</title>
    <link rel="stylesheet" href="/styling/catalogStyle.css">

</head>

<body>

<header class="top-nav">

    <div class="logo-container">

        <img src="/styling/amazonPrime.png" alt="Amazon">

    </div>

    <div class="deliver-box">

        <span>Deliver to CYBI-3345</span>

        <strong>
            📍 UTRGV 78520
        </strong>

    </div>

    <div class="search-container">

        <select>
            <option>All</option>
        </select>

        <input type="text" placeholder="Search Amazon">

        <button class="search-btn">

            <img src="/styling/magnifyingGlass.png" alt="Search">

        </button>

    </div>

    <div class="language-select">

        <img src="/styling/usFlag.png" alt="US">

        <span class="dropdown-trigger1">EN</span>
	<span class="dropdown-trigger2"> ▼</span>

        <div class="language-menu">

            <div class="menu-title">
                Change language
            </div>

            <hr>

            <label>

                <input type="radio" name="lang" value="EN" checked>
                English - EN

            </label>

            <label>

                <input type="radio" name="lang" value="ES">
                Español - ES

            </label>

            <hr>

            <div class="country-text">

                🇺🇸 You are shopping on Amazon.com

            </div>

            <div class="change-country">

                Change country/region

            </div>

        </div>

    </div>


    <div class="nav-right">

        <div class="nav-item">

            <span>Hello, CYBI-3345</span>

            <strong>Account & Lists</strong>

        </div>

        <div class="nav-item">

            <span>Returns</span>

            <strong>& Orders</strong>

        </div>

        <div class="nav-item cart"
             onclick="window.location.href='cart.html'">

            <div class="cart-amazon">

                <span id="cartCount">
                    0
                </span>

                <span class="cart-icon">
                    <img src="/styling/magnifyingGlass.png" alt="Search">
                </span>

            </div>

            <span class="cart-text">
                Cart
            </span>

        </div>

    </div>

</header>

<nav class="sub-nav">

    <span class="all-link">

        ☰ All

    </span>

    <span class="center-banner">

        FOR PROJECT / EDUCATIONAL PURPOSES ONLY

    </span>

</nav>

<section class="category-grid">

    <div class="category-card">

        <h2>Holidy Items</h2>

        <a href="holidayItems.html">

            <img src="/styling/holidayItems.jpg">

        </a>

    </div>

    <div class="category-card">

        <h2>Home Essentials</h2>

        <a href="homeEssentials.html">

            <img src="https://m.media-amazon.com/images/I/81iG4wM2f6L.jpg">

        </a>

    </div>

    <div class="category-card">

        <h2>School Essentials</h2>

        <a href="collectibles.html">

            <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/3/30/US_Silver_Dollar.jpg/640px-US_Silver_Dollar.jpg">

        </a>

    </div>

    <div class="category-card">

        <h2>Electronics</h2>

        <a href="electronics.html">

            <img src="https://images.unsplash.com/photo-1519389950473-47ba0277781c?w=900">

        </a>

    </div>

    <div class="category-card">

        <h2>Daily Deals</h2>

        <a href="dailyDeals.html">

            <img src="https://images.unsplash.com/photo-1607082349566-187342175e2f?w=900">

        </a>

    </div>

</section>

<section class="recommendation-row">

    <div class="product-card">

        <img src="https://m.media-amazon.com/images/I/61L1ItFgFHL.jpg">

        <h3>Echo Show</h3>

        <div class="price">$149.99</div>

        <button onclick="addToCart('Echo Show')">

            Add To Cart

        </button>

    </div>

    <div class="product-card">

        <img src="https://m.media-amazon.com/images/I/81iG4wM2f6L.jpg">

        <h3>Bounty Paper Towels</h3>

        <div class="price">$24.99</div>

        <button onclick="addToCart('Bounty Paper Towels')">

            Add To Cart

        </button>

    </div>

    <div class="product-card">

        <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/3/30/US_Silver_Dollar.jpg/640px-US_Silver_Dollar.jpg">

        <h3>Silver Coin</h3>

        <div class="price">$39.99</div>

        <button onclick="addToCart('Silver Coin')">

            Add To Cart

        </button>

    </div>

    <div class="product-card">

        <img src="https://m.media-amazon.com/images/I/61EXU8BuGZL.jpg">

        <h3>Echo Dot</h3>

        <div class="price">$49.99</div>

        <button onclick="addToCart('Echo Dot')">

            Add To Cart

        </button>

    </div>

    <div class="product-card">

        <img src="https://m.media-amazon.com/images/I/51TjJOTfslL.jpg">

        <h3>Fire TV Stick</h3>

        <div class="price">$39.99</div>

        <button onclick="addToCart('Fire TV Stick')">

            Add To Cart

        </button>

    </div>

</section>

<script>

async function updateCartCount()
{
    const response =
        await fetch(
            "http://127.0.0.1:5003/cart"
        );

    const items =
        await response.json();

    document
        .getElementById(
            "cartCount"
        )
        .innerText = items.length;
}

async function addToCart(item)
{
    await fetch(
        "http://127.0.0.1:5003/add",
        {
            method:"POST",

            headers:
            {
                "Content-Type":
                "application/x-www-form-urlencoded"
            },

            body:
                "item=" +
                encodeURIComponent(item)
        }
    );

    updateCartCount();
}

updateCartCount();

</script>

</body>
</html>
